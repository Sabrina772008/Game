# Copy this file to .env and change what you need.
# Never commit your real .env to GitHub (it is already in .gitignore).

# Port the server listens on. Most hosts set PORT for you automatically.
PORT=3000

# Where the SQLite database file lives. On a host, point this at a
# persistent disk/volume (for example /data/friend-arcade.db), otherwise
# accounts and coins are wiped on every redeploy.
DB_PATH=./data/friend-arcade.db

# Set to 1 when running behind a host's HTTPS proxy (Render, Railway, Fly.io,
# Nginx, Caddy). Used for rate limiting by real client IP.
TRUST_PROXY=1

# ---------------- Voice / video calls (WebRTC) ----------------
# STUN lets browsers discover their public address. Comma-separated.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relays audio/video when friends are on strict networks (mobile data,
# school or office Wi-Fi). Leave blank to run without TURN.
# Comma-separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=

# Option A: fixed TURN username/password (e.g. from Metered, Twilio, Xirsys).
TURN_USERNAME=
TURN_CREDENTIAL=

# Option B: coturn "use-auth-secret" shared secret. When set, the server
# creates short-lived TURN passwords and Option A is ignored.
TURN_SECRET=
TURN_TTL_SECONDS=3600
